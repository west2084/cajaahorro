@page "/login"
@model CajaAhorro.Pages.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión — Caja de Ahorro SNTSA 39</title>
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.0.0/tabler-icons.min.css" />
    <style>
        body { margin:0; background:#f3f4f6; font-family:'Segoe UI',system-ui,sans-serif; }
        .login-wrap {
            min-height:100vh; display:flex; align-items:center; justify-content:center;
        }
        .login-card {
            background:#fff; border:1px solid #e5e7eb; border-radius:12px;
            padding:2.25rem 2rem; width:100%; max-width:380px;
            box-shadow:0 4px 16px rgba(0,0,0,.06);
        }
        .login-header { text-align:center; margin-bottom:1.5rem; }
        .login-header img { height:64px; margin-bottom:.75rem; }
        .login-header h1 { font-size:18px; margin:0; color:#111827; }
        .login-header p  { font-size:13px; color:#6b7280; margin:.25rem 0 0; }
        .login-field { margin-bottom:1rem; }
        .login-field label { display:block; font-size:13px; font-weight:600; color:#374151; margin-bottom:.35rem; }
        .login-field input {
            width:100%; box-sizing:border-box; padding:.6rem .75rem;
            border:1px solid #d1d5db; border-radius:8px; font-size:14px;
        }
        .login-field input:focus { outline:none; border-color:#4f8ef7; box-shadow:0 0 0 3px rgba(79,142,247,.15); }
        .login-btn {
            width:100%; padding:.65rem; border:none; border-radius:8px;
            background:#1d4ed8; color:#fff; font-size:14px; font-weight:600;
            cursor:pointer; margin-top:.25rem;
        }
        .login-btn:hover { background:#1e40af; }
        .login-error {
            background:#fef2f2; border:1px solid #fecaca; color:#b91c1c;
            font-size:13px; padding:.6rem .75rem; border-radius:8px; margin-bottom:1rem;
        }
        .login-footer { text-align:center; font-size:12px; color:#9ca3af; margin-top:1.25rem; }
    </style>
</head>
<body>
    <div class="login-wrap">
        <div class="login-card">
            <div class="login-header">
                <img src="/img/logo-sntsa.png" alt="SNTSA" />
                <h1>Caja de Ahorro</h1>
                <p>SNTSA · Sección 39 · Zacatecas</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="login-error">
                    <i class="ti ti-alert-circle"></i> @Model.Error
                </div>
            }

            <form method="post">
                <div class="login-field">
                    <label for="usuario">Usuario</label>
                    <input id="usuario" name="NombreUsuario" type="text"
                           value="@Model.NombreUsuario" autocomplete="username" autofocus required />
                </div>
                <div class="login-field">
                    <label for="password">Contraseña</label>
                    <input id="password" name="Password" type="password"
                           autocomplete="current-password" required />
                </div>
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="login-btn">
                    <i class="ti ti-login"></i> Iniciar sesión
                </button>
            </form>

            <div class="login-footer">
                Sistema de administración · Acceso restringido
            </div>
        </div>
    </div>
</body>
</html>
