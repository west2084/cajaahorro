@page "/retenciones-qna"
@inject RetencionImportService RetencionSvc
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Forms
@using CajaAhorro.Services

<PageTitle>Retenciones QNA — Caja de Ahorro</PageTitle>

<div class="page-header">
    <div>
        <h1>Importar retenciones quincenales</h1>
        <p class="text-muted">Servicios de Salud o IMSS Bienestar — el sistema detecta el formato automáticamente</p>
    </div>
    <button class="btn-secondary" @onclick='() => Nav.NavigateTo("/")'>
        <i class="ti ti-arrow-left"></i> Regresar
    </button>
</div>

<div class="aviso-info" style="max-width:760px; margin-bottom:1.5rem;">
    <i class="ti ti-info-circle"></i>
    <div>
        <strong>¿Cómo funciona?</strong>
        Sube el archivo Excel de cualquier institución. El sistema identifica si es
        <strong>Servicios de Salud</strong> (columnas RFC/NOMBRE/IMPORTE/VIGENCIA)
        o <strong>IMSS Bienestar TTIB</strong> (columnas RFC/NOMBRE/QNA/TOTAL),
        extrae la quincena del nombre de la pestaña y aplica los pagos a cada préstamo.
        Si el archivo ya fue importado antes, <strong>actualiza</strong> los datos en lugar de duplicarlos.
    </div>
</div>

<!-- ── Confronta general (reconciliación universo ↔ créditos) ──────────────── -->
<div class="form-card" style="max-width:760px; margin-bottom:1.5rem;">
    <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
        <div>
            <h2 style="font-size:16px; font-weight:600; margin:0 0 .25rem;">Confronta general</h2>
            <p class="text-muted" style="margin:0; font-size:13px; max-width:520px;">
                Reaplica todos los pagos del universo de retenciones a los créditos activos,
                <strong>sin reimportar archivos</strong>. Útil cuando el pago entró antes de capturar
                el crédito o el socio era provisional. Es idempotente: se puede correr cuantas veces quieras.
            </p>
        </div>
        <button class="btn-primary" @onclick="ConfrontarGeneral" disabled="@confrontando">
            @if (confrontando)
            {
                <span><i class="ti ti-loader-2"></i> Confrontando...</span>
            }
            else
            {
                <span><i class="ti ti-arrows-right-left"></i> Confronta general</span>
            }
        </button>
    </div>

    @if (confronta is not null)
    {
        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:.75rem; margin-top:1.25rem;">
            <div class="resultado-stat">
                <span class="resultado-numero" style="color:#059669;">@confronta.PagosAplicados</span>
                <span class="resultado-label">Pagos aplicados</span>
            </div>
            <div class="resultado-stat">
                <span class="resultado-numero" style="color:#d97706;">@confronta.ConDiferencia</span>
                <span class="resultado-label">Con diferencia</span>
            </div>
            <div class="resultado-stat">
                <span class="resultado-numero" style="color:#d97706;">@confronta.SinAmortizacionQna</span>
                <span class="resultado-label">Sin amortización QNA</span>
            </div>
            <div class="resultado-stat">
                <span class="resultado-numero" style="color:#6b7280;">@confronta.Provisionales</span>
                <span class="resultado-label">Provisionales</span>
            </div>
        </div>

        <div class="stat-card" style="border-left:3px solid #059669; margin-top:1rem;">
            <span class="stat-label">Importe total aplicado · @confronta.LineasRevisadas líneas revisadas</span>
            <span class="stat-valor" style="color:#059669; font-size:20px;">@confronta.ImporteAplicado.ToString("C")</span>
        </div>

        @if (confronta.Advertencias.Any())
        {
            <details style="margin-top:.75rem;">
                <summary style="cursor:pointer; font-size:13px; color:#92400e;">
                    Ver @confronta.Advertencias.Count pendiente(s) sin aplicar
                </summary>
                <div style="background:#fffbeb; border:1px solid #fcd34d; border-radius:6px;
                            padding:.6rem .9rem; font-size:11px; font-family:monospace; color:#92400e;
                            max-height:180px; overflow-y:auto; margin-top:.5rem;">
                    @foreach (var a in confronta.Advertencias)
                    {
                        <div>@a</div>
                    }
                </div>
            </details>
        }
    }
</div>

<!-- ── Tarjeta de carga ───────────────────────────────────────────────────── -->
<div class="form-card" style="max-width:680px; margin-bottom:1.5rem;">

    <!-- Selector de archivo -->
    <div class="form-group">
        <label class="filtro-label">Archivo Excel (.xlsx)</label>
        <InputFile OnChange="OnArchivoSeleccionado" accept=".xlsx" />
        @if (nombreArchivo != "")
        {
            <span class="text-muted" style="font-size:12px; margin-top:4px; display:block;">
                <i class="ti ti-file-spreadsheet"></i> @nombreArchivo
            </span>
        }
    </div>

    <!-- Estos controles aparecen siempre que haya un archivo seleccionado -->
    @if (nombreArchivo != "")
    {
        <!-- Formato detectado -->
        @if (formatoDetectado != "")
        {
            <div class="aviso-info" style="margin:.75rem 0 .5rem; padding:.5rem .75rem; font-size:12px;">
                <i class="ti ti-scan"></i>
                <span>
                    Pestaña: <strong>@pestanaDetectada</strong>
                    &nbsp;·&nbsp;
                    Formato: <strong>@formatoDetectado</strong>
                    @if (!deteccionExitosa)
                    {
                        <span style="color:#d97706;"> — quincena no detectada, ajusta manualmente</span>
                    }
                </span>
            </div>
        }

        @if (errorValidacion != "")
        {
            <div style="background:#fef2f2; border:1px solid #fca5a5; border-radius:6px;
                        padding:.6rem .9rem; font-size:13px; color:#dc2626; margin:.75rem 0;">
                <i class="ti ti-alert-triangle"></i> @errorValidacion
            </div>
        }

        <!-- Selectores de quincena y año -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-top:.75rem;">
            <div class="form-group">
                <label class="filtro-label">Quincena</label>
                <select class="form-control" @bind="quincenaSeleccionada" @bind:after="RevisarCargaPrevia">
                    @for (int i = 1; i <= 24; i++)
                    {
                        <option value="@i">QNA @i.ToString("D2")</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="filtro-label">Año</label>
                <select class="form-control" @bind="anioSeleccionado" @bind:after="RevisarCargaPrevia">
                    @for (int y = 2024; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>
        </div>

        <!-- Log de pre-análisis -->
        @if (logAnalisis.Any())
        {
            <div style="background:#f8f9fa; border:1px solid #e5e7eb; border-radius:6px;
                        padding:10px; margin-top:.75rem; font-size:11px; font-family:monospace;
                        max-height:100px; overflow-y:auto;">
                @foreach (var l in logAnalisis)
                {
                    <div style="color:@ColorLog(l)">@l</div>
                }
            </div>
        }

        <!-- Advertencia de reimportación: la quincena ya se cargó antes -->
        @if (cargaPrevia is not null)
        {
            <div style="margin-top:.75rem;border:1px solid #fde68a;background:#fffbeb;
                        color:#92400e;border-radius:8px;padding:.75rem 1rem;font-size:13px;">
                <strong><i class="ti ti-alert-triangle"></i>
                    Esta quincena ya se importó antes:</strong>
                <div style="margin:.35rem 0;">
                    @cargaPrevia.NombreArchivo — cargado el @cargaPrevia.FechaCarga.ToString("dd/MM/yyyy HH:mm")
                    (@cargaPrevia.TotalLineas líneas, @cargaPrevia.ImporteCreditos.ToString("C0") en créditos)
                    @if (cargaPrevia.VecesImportado > 1)
                    {
                        <span> · importado @cargaPrevia.VecesImportado veces</span>
                    }
                </div>
                <label style="display:flex;align-items:center;gap:.4rem;margin-top:.35rem;cursor:pointer;">
                    <input type="checkbox" @bind="confirmarReimportacion" />
                    Entiendo — quiero reimportarla y ACTUALIZAR los registros existentes
                    (no se duplican los pagos, se reemplazan).
                </label>
            </div>
        }

        <!-- Botones -->
        <div class="form-actions" style="margin-top:1.25rem;">
            <button class="btn-primary"
                    @onclick="Importar"
                    disabled="@(cargando || errorValidacion != "" || (cargaPrevia is not null && !confirmarReimportacion))">
                @if (cargando)
                {
                    <span><i class="ti ti-loader-2"></i> Importando...</span>
                }
                else
                {
                    <span>
                        <i class="ti ti-database-import"></i>
                        Importar QNA @quincenaSeleccionada.ToString("D2")/@anioSeleccionado
                    </span>
                }
            </button>
            <button class="btn-secondary" @onclick="Limpiar" disabled="@cargando">
                <i class="ti ti-x"></i> Cancelar
            </button>
        </div>
    }
</div>

<!-- ── Resultado ──────────────────────────────────────────────────────────── -->
@if (resultado is not null)
{
    <div class="form-card" style="max-width:760px; margin-bottom:1.5rem;">

        @if (resultado.Exitoso)
        {
            <div style="display:flex; align-items:center; gap:.6rem; margin-bottom:1.25rem;
                        background:#f0fdf4; border:1px solid #86efac; border-radius:8px;
                        padding:.7rem 1rem; font-size:13px;">
                <i class="ti ti-circle-check" style="color:#16a34a; font-size:1.3rem;"></i>
                <div>
                    @if (resultado.EsReimportacion)
                    {
                        <strong>Reimportación</strong>
                        <span> — QNA @resultado.Quincena.ToString("D2")/@resultado.Anio actualizada.</span>
                    }
                    else
                    {
                        <strong>Importación exitosa</strong>
                        <span> — QNA @resultado.Quincena.ToString("D2")/@resultado.Anio · @resultado.FormatoDetectado</span>
                    }
                </div>
            </div>
        }
        else
        {
            <div style="display:flex; align-items:center; gap:.6rem; margin-bottom:1.25rem;
                        background:#fef2f2; border:1px solid #fca5a5; border-radius:8px;
                        padding:.7rem 1rem; font-size:13px;">
                <i class="ti ti-alert-triangle" style="color:#dc2626; font-size:1.3rem;"></i>
                <div><strong>Error al importar:</strong> @resultado.Error</div>
            </div>
        }

        <!-- Estadísticas -->
        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:.75rem; margin-bottom:1.25rem;">
            <div class="resultado-stat">
                <span class="resultado-numero">@resultado.TotalLineasArchivo</span>
                <span class="resultado-label">Líneas leídas</span>
            </div>
            <div class="resultado-stat">
                <span class="resultado-numero" style="color:#d97706;">@resultado.SociosProvisionales</span>
                <span class="resultado-label">Provisionales creados</span>
            </div>
            <div class="resultado-stat">
                <span class="resultado-numero" style="color:#d97706;">@resultado.SociosNoEncontrados</span>
                <span class="resultado-label">RFC no en caja</span>
            </div>
            <div class="resultado-stat">
                <span class="resultado-numero" style="color:#6b7280;">@resultado.LineasIgnoradas</span>
                <span class="resultado-label">Ignoradas</span>
            </div>
        </div>

        <div class="stat-card" style="border-left:3px solid #059669; margin-bottom:1rem;">
            <span class="stat-label">Importe total aplicado</span>
            <span class="stat-valor" style="color:#059669; font-size:20px;">
                @resultado.ImporteTotal.ToString("C")
            </span>
        </div>

        @if (resultado.SinAmortizacion > 0)
        {
            <div style="background:#fffbeb; border:1px solid #fcd34d; border-radius:6px;
                        padding:.6rem .9rem; font-size:12px; color:#92400e; margin-bottom:.75rem;">
                <i class="ti ti-alert-triangle"></i>
                <strong>@resultado.SinAmortizacion socio(s)</strong> en la caja pero sin amortización
                pendiente para esta quincena. Verifica si sus préstamos ya están liquidados.
            </div>
        }

        @if (resultado.Advertencias.Any())
        {
            <details style="margin-bottom:.75rem;">
                <summary style="cursor:pointer; font-size:12px; color:#d97706; user-select:none;">
                    <i class="ti ti-alert-triangle"></i>
                    @resultado.Advertencias.Count advertencia(s)
                </summary>
                <ul style="margin:.5rem 0 0 1rem; font-size:12px; color:#92400e;">
                    @foreach (var w in resultado.Advertencias.Take(50))
                    {
                        <li>@w</li>
                    }
                    @if (resultado.Advertencias.Count > 50)
                    {
                        <li class="text-muted">... y @(resultado.Advertencias.Count - 50) más</li>
                    }
                </ul>
            </details>
        }

        <details>
            <summary style="cursor:pointer; font-size:12px; color:#6b7280; user-select:none;">
                <i class="ti ti-terminal"></i> Log de proceso (@resultado.Log.Count entradas)
            </summary>
            <div style="background:#f8f9fa; border:1px solid #e5e7eb; border-radius:6px;
                        padding:10px; margin-top:.5rem; font-size:11px; font-family:monospace;
                        max-height:220px; overflow-y:auto;">
                @foreach (var l in resultado.Log)
                {
                    <div style="color:@ColorLog(l)">@l</div>
                }
            </div>
        </details>

        <div style="margin-top:1.25rem;">
            <button class="btn-primary" @onclick="Limpiar">
                <i class="ti ti-upload"></i> Cargar otro archivo
            </button>
        </div>
    </div>
}

<!-- ── Historial ───────────────────────────────────────────────────────────── -->
@if (historial.Any())
{
    <div class="form-card" style="max-width:760px;">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
            <h2 style="margin:0;">Historial de importaciones</h2>
            <span class="text-muted" style="font-size:12px;">
                @historialTotal archivo@(historialTotal == 1 ? "" : "s")
            </span>
        </div>
        <div class="table-container">
            <table class="tabla tabla-sm">
                <thead>
                    <tr>
                        <th>Quincena</th>
                        <th>Archivo</th>
                        <th>Formato</th>
                        <th class="text-right">Pagos</th>
                        <th class="text-right">Importe</th>
                        <th>Fecha carga</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in historial)
                    {
                        <tr>
                            <td><strong>QNA @h.Quincena.ToString("D2")/@h.Anio</strong></td>
                            <td style="font-size:11px; color:#6b7280; max-width:200px;
                                       overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                title="@h.NombreArchivo">
                                @h.NombreArchivo
                            </td>
                            <td>
                                <span class="badge @(h.Formato.Contains("SALUD") ? "badge-green" : "badge-blue")"
                                      style="font-size:10px;">
                                    @h.Formato
                                </span>
                            </td>
                            <td class="text-right">@h.CreditosAplicados</td>
                            <td class="text-right" style="color:#059669; font-weight:500;">
                                @h.ImporteCreditos.ToString("C0")
                            </td>
                            <td style="font-size:11px; color:#6b7280;">
                                @h.FechaCarga.ToString("dd/MM/yy HH:mm")
                                @if (h.VecesImportado > 1)
                                {
                                    <span class="badge badge-yellow" style="font-size:10px; margin-left:4px;">
                                        @h.VecesImportado×
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginación: con 50+ archivos importados, mostrar todo de golpe se
             ve saturado — aquí solo se renderiza una página a la vez. -->
        @if (historialTotalPaginas > 1)
        {
            <div style="display:flex; align-items:center; justify-content:center; gap:.5rem; margin-top:1rem;">
                <button class="btn-icon" title="Primera página"
                        disabled="@(historialPagina <= 1)"
                        @onclick="() => IrAPaginaHistorial(1)">
                    <i class="ti ti-chevrons-left"></i>
                </button>
                <button class="btn-icon" title="Anterior"
                        disabled="@(historialPagina <= 1)"
                        @onclick="() => IrAPaginaHistorial(historialPagina - 1)">
                    <i class="ti ti-chevron-left"></i>
                </button>

                <span class="text-muted" style="font-size:12px; min-width:110px; text-align:center;">
                    Página @historialPagina de @historialTotalPaginas
                </span>

                <button class="btn-icon" title="Siguiente"
                        disabled="@(historialPagina >= historialTotalPaginas)"
                        @onclick="() => IrAPaginaHistorial(historialPagina + 1)">
                    <i class="ti ti-chevron-right"></i>
                </button>
                <button class="btn-icon" title="Última página"
                        disabled="@(historialPagina >= historialTotalPaginas)"
                        @onclick="() => IrAPaginaHistorial(historialTotalPaginas)">
                    <i class="ti ti-chevrons-right"></i>
                </button>
            </div>
        }
    </div>
}

@code {
    // ── Estado ────────────────────────────────────────────────────────────────
    private IBrowserFile? archivoRef;           // referencia al IBrowserFile
    private string nombreArchivo = "";
    private bool cargando = false;
    private bool deteccionExitosa = false;
    private PagoQuincenalEncabezado? cargaPrevia;
    private bool confirmarReimportacion = false;

    /// <summary>Re-checar si la quincena elegida ya se cargó, cuando el
    /// usuario la ajusta manualmente después del análisis.</summary>
    private async Task RevisarCargaPrevia()
    {
        if (archivoRef is null || string.IsNullOrEmpty(formatoDetectado)) return;
        cargaPrevia = await RetencionSvc.ObtenerCargaPreviaAsync(
            quincenaSeleccionada, anioSeleccionado, formatoDetectado.Contains("IMSS"));
        confirmarReimportacion = false;
    }
    private string pestanaDetectada = "";
    private string formatoDetectado = "";
    private string errorValidacion = "";
    private int quincenaSeleccionada = 1;
    private int anioSeleccionado = DateTime.Today.Year;

    private List<string> logAnalisis = new();
    private RetencionImportService.ResultadoImportacion? resultado;
    private List<PagoQuincenalEncabezado> historial = new();
    private int historialPagina = 1;
    private int historialTotalPaginas = 1;
    private int historialTotal = 0;
    private const int TamanoPaginaHistorial = 15;

    // Confronta general
    private bool confrontando = false;
    private RetencionImportService.ResultadoConfronta? confronta;

    protected override async Task OnInitializedAsync()
    {
        await CargarHistorial(1);
    }

    private async Task CargarHistorial(int pagina)
    {
        var pag = await RetencionSvc.ObtenerHistorialPaginadoAsync(pagina, TamanoPaginaHistorial);
        historial = pag.Items;
        historialPagina = pag.Pagina;
        historialTotalPaginas = pag.TotalPaginas;
        historialTotal = pag.TotalRegistros;
    }

    private async Task IrAPaginaHistorial(int pagina)
    {
        await CargarHistorial(pagina);
    }

    // ── Confronta general ─────────────────────────────────────────────────────
    private async Task ConfrontarGeneral()
    {
        confrontando = true;
        confronta = null;
        try
        {
            confronta = await RetencionSvc.ConfrontarAsync();   // sin filtros = todo el universo
            await CargarHistorial(historialPagina);
        }
        finally
        {
            confrontando = false;
        }
    }

    // ── Selección de archivo ─────────────────────────────────────────────────
    private async Task OnArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        archivoRef = e.File;
        nombreArchivo = e.File.Name;
        resultado = null;
        logAnalisis = new();
        deteccionExitosa = false;
        cargaPrevia = null;
        confirmarReimportacion = false;
        pestanaDetectada = "";
        formatoDetectado = "";
        errorValidacion = "";

        // Pre-análisis: detectar formato y quincena sin importar
        try
        {
            using var stream = archivoRef.OpenReadStream(maxAllowedSize: 30 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            using var wb = new ClosedXML.Excel.XLWorkbook(ms);
            var hoja = wb.Worksheets.FirstOrDefault();

            if (hoja is null)
            {
                errorValidacion = "El archivo no contiene hojas.";
                StateHasChanged();
                return;
            }

            pestanaDetectada = hoja.Name;

            // Detectar formato — mismo criterio que RetencionImportService.
            // "IMSS BIENESTAR PRÉSTAMOS" se revisa PRIMERO porque su título
            // también contiene "ZACATECAS" y se confundiría con Servicios de
            // Salud si se revisara después.
            var f1 = hoja.Cell(1, 1).GetValue<string>().ToUpper();
            formatoDetectado =
                (f1.Contains("RETENCIONES POR CONCEPTO") || f1.Contains("PRESTAMOS - AA39"))
                    ? "IMSS BIENESTAR PRESTAMOS"
                    : (f1.Contains("SERVICIOS DE SALUD") || f1.Contains("ZACATECAS"))
                        ? "SERVICIOS DE SALUD"
                        : "IMSS BIENESTAR TTIB";

            // Validar columnas requeridas
            string[] colsReq = formatoDetectado switch
            {
                "SERVICIOS DE SALUD" => new[] { "RFC", "NOMBRE", "IMPORTE", "VIGENCIA", "TIPO NOMINA" },
                "IMSS BIENESTAR PRESTAMOS" => new[] { "RFC", "CURP" },
                _ => new[] { "RFC", "NOMBRE COMPLETO" }
            };

            bool columnasOk = false;
            for (int r = 1; r <= 10; r++)
            {
                var celdas = Enumerable.Range(1, 10)
                    .Select(c => hoja.Cell(r, c).GetValue<string>().Trim().ToUpper())
                    .Where(v => !string.IsNullOrEmpty(v))
                    .ToList();

                if (colsReq.All(col => celdas.Any(c => c.Contains(col))))
                {
                    columnasOk = true;
                    logAnalisis.Add($"[OK] Columnas validadas en fila {r}");
                    break;
                }
            }

            if (!columnasOk)
            {
                errorValidacion = $"El archivo no tiene el formato esperado para {formatoDetectado}. " +
                                  $"Se esperaban las columnas: {string.Join(", ", colsReq)}.";
                logAnalisis.Add($"[ERROR] {errorValidacion}");
                StateHasChanged();
                return;
            }

            // Extraer quincena. El formato "IMSS BIENESTAR PRÉSTAMOS" suele
            // venir en una sola hoja sin info de quincena en el NOMBRE de la
            // pestaña (p. ej. "Hoja1") — se busca en el TÍTULO en su lugar.
            var textoQna = formatoDetectado == "IMSS BIENESTAR PRESTAMOS"
                ? hoja.Cell(1, 1).GetValue<string>()
                : hoja.Name;

            var match = System.Text.RegularExpressions.Regex.Match(
                textoQna,
                @"QNA\.?\s*(\d{1,2})\s*[/\-]?\s*(20\d{2})",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);

            if (match.Success
                && int.TryParse(match.Groups[1].Value, out int q)
                && int.TryParse(match.Groups[2].Value, out int a)
                && q >= 1 && q <= 24)
            {
                quincenaSeleccionada = q;
                anioSeleccionado = a;
                deteccionExitosa = true;
                logAnalisis.Add($"[OK] Formato: {formatoDetectado} · QNA {q:D2}/{a}");

                // ¿Ya se cargó esta quincena para esta institución? Avisar y
                // pedir confirmación explícita antes de dejar reimportar.
                cargaPrevia = await RetencionSvc.ObtenerCargaPreviaAsync(
                    q, a, formatoDetectado.Contains("IMSS"));
                confirmarReimportacion = false;
                if (cargaPrevia is not null)
                    logAnalisis.Add($"[AVISO] Esta quincena ya se cargó el {cargaPrevia.FechaCarga:dd/MM/yyyy} " +
                                    $"({cargaPrevia.NombreArchivo}).");
            }
            else
            {
                logAnalisis.Add($"[WARN] No se detectó quincena en «{hoja.Name}» — ajusta manualmente.");
            }
        }
        catch (Exception ex)
        {
            errorValidacion = $"Error al leer el archivo: {ex.Message}";
            logAnalisis.Add($"[ERROR] {ex.Message}");
        }

        StateHasChanged();
    }

    // ── Importar ─────────────────────────────────────────────────────────────
    private async Task Importar()
    {
        if (archivoRef is null) return;

        cargando = true;
        resultado = null;
        StateHasChanged();

        try
        {
            using var stream = archivoRef.OpenReadStream(maxAllowedSize: 30 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            resultado = await RetencionSvc.ImportarAsync(
                ms,
                nombreArchivo,
                quincenaOverride: quincenaSeleccionada,
                anioOverride: anioSeleccionado);

            await CargarHistorial(1);
        }
        catch (Exception ex)
        {
            resultado = new RetencionImportService.ResultadoImportacion
                {
                    Exitoso = false,
                    Error = ex.Message,
                };
        }
        finally
        {
            cargando = false;
        }
    }

    // ── Limpiar ───────────────────────────────────────────────────────────────
    private void Limpiar()
    {
        archivoRef = null;
        nombreArchivo = "";
        resultado = null;
        logAnalisis = new();
        deteccionExitosa = false;
        cargaPrevia = null;
        confirmarReimportacion = false;
        pestanaDetectada = "";
        formatoDetectado = "";
        errorValidacion = "";
    }

    private static string ColorLog(string l) => l switch
    {
        var s when s.StartsWith("[ERROR") => "#dc2626",
        var s when s.StartsWith("[WARN]") => "#d97706",
        var s when s.StartsWith("[OK]") => "#16a34a",
        _ => "#374151"
    };
}